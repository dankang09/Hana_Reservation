# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 소셜 로그인 (선택)
KAKAO_CLIENT_ID=
KAKAO_SECRET=
NAVER_CLIENT_ID=
NAVER_SECRET=

# 이메일 인증용 SMTP (선택, Gmail 앱 비밀번호)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Twilio SMS 알림 (선택, 비워두면 SMS 발송 생략)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SITE_URL=http://127.0.0.1:8000/
